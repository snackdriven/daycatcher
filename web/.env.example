# Meat-Suit Web — environment
# Copy this file to .env and fill in.

# LLM key. Default points at Gemini's free tier (1500 req/day on Flash).
# Grab one at https://aistudio.google.com/apikey — Google account, no card.
# Works with any OpenAI-compatible provider.
LLM_API_KEY=

# OpenAI-compatible endpoint. Default = Gemini.
# OpenAI:     https://api.openai.com/v1/
# Groq:       https://api.groq.com/openai/v1/
# OpenRouter: https://openrouter.ai/api/v1/
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Model. Match the provider above.
# Gemini:  gemini-2.0-flash, gemini-2.5-flash, gemini-2.5-pro
# OpenAI:  gpt-4o-mini, gpt-4o
LLM_MODEL=gemini-2.0-flash

# Optional. Defaults to 5000.
PORT=5000
