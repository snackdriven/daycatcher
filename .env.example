# Project Meat-Suit — environment
# Copy this file to .env and fill in.

# LLM key. Default points at Gemini's free tier (1500 req/day on Flash).
# Grab one at https://aistudio.google.com/apikey — Google account, no card.
# Works with any OpenAI-compatible provider; just set LLM_BASE_URL too.
LLM_API_KEY=

# OpenAI-compatible endpoint. Default = Gemini.
# OpenAI:     https://api.openai.com/v1/
# Groq:       https://api.groq.com/openai/v1/
# OpenRouter: https://openrouter.ai/api/v1/
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Models — change to match the provider above.
# Gemini examples:  gemini-2.0-flash, gemini-2.5-flash, gemini-2.5-pro
# OpenAI examples:  gpt-4o-mini, gpt-4o
MIND1_PERSONA_MODEL=gemini-2.0-flash
MIND2_SCRIBE_MODEL=gemini-2.0-flash
MIND3_WEAVER_MODEL=gemini-2.0-flash

# Local SQLite path
DATABASE_PATH=./data/meatsuit.db

# Timezone for the Weaver's 11:59 PM cron
TIMEZONE=America/Chicago

# Anti-PDA bait nudges (set to 0 to disable)
NUDGES_ENABLED=1

# Sleep nudge window. Weeknight = Sun-Thu, Weekend = Fri-Sat.
# 23 means "after 11pm", 1 means "after 1am". Set SLEEP_NUDGES_ENABLED=0 to mute.
SLEEP_WEEKNIGHT_HOUR=23
SLEEP_WEEKEND_HOUR=1
SLEEP_NUDGES_ENABLED=1

# --- web ---
# Bind address. 127.0.0.1 = localhost only. Set to 0.0.0.0 ONLY when running
# behind a tunnel (Cloudflare Tunnel, ngrok, Tailscale Funnel, etc.).
WEB_BIND_HOST=127.0.0.1
WEB_PORT=5050

# Single shared secret for cookie auth. Auto-generated on first boot if absent.
# Visit /?key=YOUR_KEY once on each browser to set the auth cookie (1y expiry).
MEAT_SUIT_WEB_KEY=

# Set to 1 only behind HTTPS (Cloudflare Tunnel adds this for you).
WEB_COOKIE_SECURE=0
