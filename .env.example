# Project Meat-Suit — environment
# Copy this file to .env and fill in.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID — locks the bot to ONLY you (privacy)
# Get yours by messaging @userinfobot
TELEGRAM_OWNER_ID=

# OpenAI
OPENAI_API_KEY=

# Models — change if you want
MIND1_PERSONA_MODEL=gpt-4o-mini
MIND2_SCRIBE_MODEL=gpt-4o-mini
MIND3_WEAVER_MODEL=gpt-4o

# Local SQLite path
DATABASE_PATH=./data/meatsuit.db

# Timezone for the Weaver's 11:59 PM cron
TIMEZONE=America/Chicago

# Anti-PDA bait nudges (set to 0 to disable)
NUDGES_ENABLED=1
